{
  "name": "swarmalpha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node -e \"throw new Error('legacy command blocked; use npm run legacy:demo after reading docs/ACTIVE_RESEARCH_SURFACE.md')\"",
    "experiment": "node -e \"throw new Error('legacy paid experiment blocked; use an explicitly frozen current runner or npm run legacy:v2:run')\"",
    "analyze": "node -e \"throw new Error('ambiguous legacy analysis blocked; use a named current analyzer or npm run legacy:v2:analyze')\"",
    "sensitivity": "node -e \"throw new Error('legacy command blocked; use npm run legacy:v2:sensitivity')\"",
    "legacy:demo": "tsx experiments/demo.ts",
    "legacy:v2:run": "tsx experiments/v2/run.ts",
    "legacy:v2:analyze": "tsx experiments/v2/analyze.ts",
    "legacy:v2:sensitivity": "tsx experiments/v2/sensitivity.ts",
    "verify:replay": "tsx experiments/campaign/verify_replay.ts",
    "v6:smoke": "tsx experiments/campaign/v6/run_v6_smoke.ts",
    "measurement:plan": "tsx experiments/campaign/measurement/run_v6_measurement_development.ts --plan",
    "measurement:mock": "tsx experiments/campaign/measurement/run_v6_measurement_development.ts --mock",
    "test:v6": "vitest run v6 production-vertical-slice hiddenbench-v6-task-adapter --no-file-parallelism",
    "test:measurement": "vitest run measurement-validity v6-measurement-development --no-file-parallelism"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.9"
  }
}
